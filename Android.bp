soong_namespace {
    imports: ["hardware/xiaomi"],
}

android_app {
    name: "XiaomiSmartQR",
    srcs: ["src/**/*.kt"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
        "SettingsLib",
        "vendor.xiaomi.hardware.aon-V1-java",
    ],
}
