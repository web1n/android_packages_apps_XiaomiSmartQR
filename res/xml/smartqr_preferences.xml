<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/app_name">
    <com.android.settingslib.widget.MainSwitchPreference
        android:key="smartqr_enabled"
        android:title="@string/enable_title"
        android:persistent="false" />
    <com.android.settingslib.widget.FooterPreference
        android:title="@string/feature_description" android:selectable="false" />
    <SwitchPreferenceCompat
        android:key="prefer_default_app"
        android:dependency="smartqr_enabled"
        android:title="@string/prefer_default_app_title"
        android:summary="@string/prefer_default_app_summary"
        android:defaultValue="true"
        android:persistent="false" />
    <PreferenceCategory android:key="scan_apps"
        android:dependency="smartqr_enabled"
        android:title="@string/scan_apps_title" />
</PreferenceScreen>
