<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.smartqr"
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_smartqr"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <activity
            android:name=".ui.SmartQrSettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.gestures" />
            <meta-data android:name="com.android.settings.icon"
                android:resource="@drawable/ic_smartqr" />
            <meta-data android:name="com.android.settings.summary"
                android:resource="@string/settings_summary" />
        </activity>
    </application>
</manifest>
